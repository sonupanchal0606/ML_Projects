{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug House Price API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.api:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true,
      "python": "${workspaceFolder}/.venv/bin/python"
    }
  ]
}
